#!/bin/sh
# THE BACKUP ONCE A DAY, ON THE DAY'S FIRST COMMIT (9 Nov 2026, RULINGS 9 Nov,
# records: FOR-JAFAR.md's summary is stopped, so it can no longer set the
# backup off). From 25 September to 9 November a commit changing FOR-JAFAR.md
# ran it (Jafar: "make it run at the end of every sitting"). Now the first
# commit of each local day runs tools/backup-to-dropbox.py: the day counts as
# backed up once backup-to-dropbox.log (in the shared git folder) holds a line
# stamped with today's date. The backup only ever adds to his Dropbox's
# "LEDGER backup" folder (it never deletes, never overwrites, never writes
# outside it, never fills drive C:). Installed with:
#   cp tools/hooks/post-commit .git/hooks/post-commit
# The shared git folder, so a commit from a worktree (where .git is a file)
# logs too; in the main checkout it is .git, as before.
log="$(git rev-parse --git-common-dir)/backup-to-dropbox.log"
# Local time from Python (Windows' own clock and zone), never Git Bash's date.
today=$(python -c "import datetime; print(datetime.date.today().isoformat())" 2>/dev/null)
[ -n "$today" ] || exit 0
if ! grep -q "^$today" "$log" 2>/dev/null; then
  line=$(python tools/backup-to-dropbox.py 2>&1 | tail -1)
  stamp=$(python -c "import datetime; print(datetime.datetime.now().strftime('%Y-%m-%dT%H:%M:%S'))")
  echo "$stamp $(git rev-parse --short HEAD) $line" >> "$log"
  echo "post-commit: $line"
fi
exit 0
