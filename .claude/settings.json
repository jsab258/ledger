{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin main*)",
      "Bash(dotnet run *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet --version)",
      "Bash(powershell.exe -NoProfile -File tools/ue/build-local.ps1)",
      "Bash(python tools/ai-tester/play.py close)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/page_read_hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/stop_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unreal-engine-skills-for-claude-code@claude-plugins-official": true,
    "cowork-plugin-management@knowledge-work-plugins": false
  },
  "skillOverrides": {
    "2bcs-pptx": "user-invocable-only",
    "anthropic-skills:2bcs-pptx": "user-invocable-only",
    "config-sheet-reader": "user-invocable-only",
